rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUnitCode(code) {
      return code is string
        && code.size() >= 2
        && code.size() <= 10
        && code.matches('^(A[12]|B1|C([1-9]|1[0-4])|D[1-3]|E([1-9]|1[0-9]|2[0-2])|F[1-8]|G([1-9]|[1-4][0-9]|5[0-2])|H[1-5])$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'el.property76@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUnitReservation(data) {
      return data.keys().hasAll(['unitCode', 'blockId', 'status', 'bookedByUid', 'bookingId', 'updatedAt'])
        && data.keys().hasOnly(['unitCode', 'blockId', 'status', 'bookedByUid', 'bookingId', 'updatedAt'])
        && isValidUnitCode(data.unitCode)
        && data.blockId is string && data.blockId in ['A', 'B', 'C', 'D', 'E', 'F', 'G1', 'G2', 'H']
        && data.status is string && data.status in ['booked', 'confirmed']
        && isValidId(data.bookedByUid)
        && isValidId(data.bookingId)
        && data.updatedAt is timestamp;
    }

    function isValidUnitBooking(data) {
      return data.keys().hasAll([
          'bookingCode', 'userId', 'unitCode', 'blockId', 'blockName',
          'fullName', 'whatsapp', 'email', 'paymentScheme', 'notes',
          'status', 'investmentValueLabel', 'transferProofName', 'ktpPhotoName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingCode', 'userId', 'unitCode', 'blockId', 'blockName',
          'fullName', 'whatsapp', 'email', 'paymentScheme', 'notes',
          'status', 'investmentValueLabel', 'transferProofName', 'ktpPhotoName',
          'createdAt', 'updatedAt'
        ])
        && data.bookingCode is string && data.bookingCode.size() >= 6 && data.bookingCode.size() <= 24 && data.bookingCode.matches('^HSHJ-[A-Z0-9-]+$')
        && isValidId(data.userId)
        && isValidUnitCode(data.unitCode)
        && data.blockId is string && data.blockId in ['A', 'B', 'C', 'D', 'E', 'F', 'G1', 'G2', 'H']
        && data.blockName is string && data.blockName.size() >= 3 && data.blockName.size() <= 80
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.whatsapp is string && data.whatsapp.size() >= 9 && data.whatsapp.size() <= 20 && data.whatsapp.matches('^(\\+62|62|0)[0-9]{8,15}$')
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.paymentScheme is string && data.paymentScheme in ['cash_keras', 'cicilan_syariah']
        && data.notes is string && data.notes.size() <= 400
        && data.status is string && data.status in ['pending', 'confirmed', 'cancelled']
        && data.investmentValueLabel is string && data.investmentValueLabel.size() >= 3 && data.investmentValueLabel.size() <= 40
        && data.transferProofName is string && data.transferProofName.size() >= 3 && data.transferProofName.size() <= 140
        && data.ktpPhotoName is string && data.ktpPhotoName.size() >= 3 && data.ktpPhotoName.size() <= 140
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection check document (no PII)
    match /test/connection {
      allow get: if true;
    }

    // Public non-PII unit reservation lock status
    match /unit_reservations/{unitCode} {
      allow get: if isValidUnitCode(unitCode);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidUnitCode(unitCode)
        && isValidUnitReservation(incoming())
        && incoming().unitCode == unitCode
        && incoming().bookedByUid == request.auth.uid
        && incoming().status == 'booked'
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId));
      allow update: if isVerifiedUser()
        && isValidUnitCode(unitCode)
        && isValidUnitReservation(incoming())
        && incoming().unitCode == existing().unitCode
        && incoming().bookedByUid == existing().bookedByUid
        && incoming().bookingId == existing().bookingId
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidUnitCode(unitCode) && (
        isAdmin() || (
          isVerifiedUser()
          && existing().bookedByUid == request.auth.uid
          && existing().status == 'booked'
          && getAfter(/databases/$(database)/documents/bookings/$(existing().bookingId)).data.status == 'cancelled'
        )
      );
    }

    // Private booking records (PII isolated to owner & admin)
    match /bookings/{bookingId} {
      allow get: if isSignedIn()
        && isValidId(bookingId)
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidUnitBooking(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/unit_reservations/$(incoming().unitCode));
      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidUnitBooking(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().userId == existing().userId
        && incoming().unitCode == existing().unitCode
        && incoming().blockId == existing().blockId
        && incoming().bookingCode == existing().bookingCode
        && incoming().updatedAt == request.time
        && existing().status != 'cancelled'
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (existing().userId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }
  }
}
